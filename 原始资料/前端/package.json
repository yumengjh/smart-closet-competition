{
  "name": "smart-closet-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc -b && vite build",
    "build:server": "vue-tsc -b && VITE_API_BASE_URL='' VITE_USE_MOCKS=false vite build && node scripts/publish-to-server.mjs",
    "build:standalone": "vue-tsc -b && CLOSET_STANDALONE_BUILD=true VITE_USE_MOCKS=false vite build",
    "deploy:local": "bash scripts/deploy-local.sh",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "vue-tsc -b",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@foleyjs/core": "^2.9.0",
    "ant-design-vue": "^4.2.6",
    "konva": "^10.7.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.13",
    "vue-konva": "^4.0.1",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  }
}
